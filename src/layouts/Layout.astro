---
import '../styles/global.css';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Imported so Vite fingerprints and copies them, and the preload href below
// always matches the hashed filename the CSS actually requests.
import poppins700Latin from '@fontsource/poppins/files/poppins-latin-700-normal.woff2?url';
import poppins700LatinExt from '@fontsource/poppins/files/poppins-latin-ext-700-normal.woff2?url';

interface Props {
  /** Keep under ~43 chars: the brand suffix adds 17 and Google cuts near 60. */
  baslik: string;
  /** Aim for 150 to 160 chars. */
  aciklama: string;
  /** Absolute-from-root path to the social preview image. */
  gorsel?: string;
  gorselAlt?: string;
  /** Breadcrumb trail for detail pages, in order, excluding the home link. */
  kirintiYolu?: { ad: string; yol: string }[];
  /** Extra JSON-LD graph nodes contributed by the page. */
  semaEkleri?: Record<string, unknown>[];
}

const {
  baslik,
  aciklama,
  gorsel = '/brand/og-default.png',
  gorselAlt = 'Mevcut Digital',
  kirintiYolu = [],
  semaEkleri = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const gorselMutlak = new URL(gorsel, Astro.site).href;
// Pipe rather than an em dash. The dash is the single most recognisable AI tell
// and it shows up in the SERP, which is the first thing a prospect ever sees.
const tamBaslik = `${baslik} | ${site.ad}`;

const kurulusSema = {
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#kurulus`,
  name: site.ad,
  slogan: site.slogan,
  description: aciklama,
  url: site.url,
  telephone: site.telefon,
  email: site.eposta,
  image: `${site.url}/brand/og-default.png`,
  logo: `${site.url}/brand/lotus-favicon.svg`,
  priceRange: '$$',
  knowsLanguage: 'tr',
  areaServed: [
    { '@type': 'City', name: 'İstanbul' },
    { '@type': 'Country', name: 'Türkiye' },
  ],
  address: { '@type': 'PostalAddress', addressLocality: 'İstanbul', addressCountry: 'TR' },
  serviceType: [
    'Web sitesi tasarımı',
    'Küçük işletme web sitesi',
    'Restoran web sitesi',
    'Berber web sitesi',
  ],
};

const kirintiSema =
  kirintiYolu.length > 0
    ? {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: site.url },
          ...kirintiYolu.map((k, i) => ({
            '@type': 'ListItem',
            position: i + 2,
            name: k.ad,
            item: new URL(k.yol, site.url).href,
          })),
        ],
      }
    : null;

const sema = {
  '@context': 'https://schema.org',
  '@graph': [kurulusSema, kirintiSema, ...semaEkleri].filter(Boolean),
};

// JSON.stringify does not escape "</script>", so close the tag defensively.
// Every value here is authored, but this keeps it safe if data ever comes from elsewhere.
const semaJson = JSON.stringify(sema).replace(/<\//g, '<\\/');
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tamBaslik}</title>
    <meta name="description" content={aciklama} />
    <link rel="canonical" href={canonical} />

    {/*
      Must be lotus-favicon.svg, not lotus.svg: the latter is fill="currentColor"
      for in-page use, and a favicon inherits no colour, so it would render black.
      This one carries its own navy plate and stone mark.
    */}
    <link rel="icon" href="/brand/lotus-favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <meta name="theme-color" content="#2E3B69" />

    {/*
      The h1 above the fold is Poppins 700. Preloading it removes a render-blocking
      round trip after CSS parse, which is the main LCP cost on this page. Only the
      two subsets Turkish actually needs are preloaded.
    */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href={poppins700Latin}
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href={poppins700LatinExt}
    />

    <meta name="robots" content="index, follow, max-image-preview:large" />

    {/* WhatsApp and Facebook read these from the raw HTML. They never run JS. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.ad} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={tamBaslik} />
    <meta property="og:description" content={aciklama} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={gorselMutlak} />
    <meta property="og:image:alt" content={gorselAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tamBaslik} />
    <meta name="twitter:description" content={aciklama} />
    <meta name="twitter:image" content={gorselMutlak} />

    {/*
      Runs before paint so the reveal styles only ever apply when scripting is
      available. Without this class nothing is hidden, so a failed script can
      never leave the page blank. Inline and tiny by design.
    */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <script type="application/ld+json" set:html={semaJson} />
  </head>

  <body>
    <a
      href="#icerik"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-navy focus:px-5 focus:py-3 focus:text-stone focus:rounded"
    >
      İçeriğe geç
    </a>

    <Header />
    <main id="icerik">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll reveal. IntersectionObserver only toggles a class; CSS owns the motion,
      // and the reduced-motion media query neutralises it entirely.
      const azHareket = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const hedefler = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));

      const goster = (el: HTMLElement) => el.classList.add('is-visible');

      if (azHareket || !('IntersectionObserver' in window)) {
        hedefler.forEach(goster);
      } else {
        const gozlemci = new IntersectionObserver(
          (girisler) => {
            girisler.forEach((giris) => {
              if (giris.isIntersecting) {
                goster(giris.target as HTMLElement);
                gozlemci.unobserve(giris.target);
              }
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.1 },
        );

        // Anything at or above the fold on first paint is shown outright. Without
        // this, landing on a hash link like /#hizmetler leaves every section above
        // the anchor permanently invisible, because it never intersects.
        for (const el of hedefler) {
          if (el.getBoundingClientRect().top < window.innerHeight) {
            goster(el);
          } else {
            gozlemci.observe(el);
          }
        }
      }
    </script>
  </body>
</html>
