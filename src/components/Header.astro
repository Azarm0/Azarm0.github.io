---
import Logo from './Logo.astro';
import { site, whatsapp } from '../data/site';

/*
 * One list, rendered twice: inline from md up, inside a disclosure below it. Two
 * hardcoded copies drifted apart the moment a fourth section was considered.
 */
const menu = [
  { ad: 'İşlerimiz', yol: '/#isler' },
  { ad: 'Hizmetler', yol: '/#hizmetler' },
  { ad: 'Süreç', yol: '/#surec' },
];
---

<header
  class="sticky top-0 z-40 border-b border-charcoal/10 bg-stone/85 backdrop-blur-md supports-[backdrop-filter]:bg-stone/70"
>
  <div class="container-page flex h-16 items-center justify-between gap-4 md:h-20">
    <a
      href="/"
      class="flex min-h-11 min-w-11 items-center gap-3 text-navy transition-opacity duration-200 hover:opacity-80"
      aria-label={`${site.ad} ana sayfa`}
    >
      <Logo class="h-8 w-auto md:h-9" />
      {/*
        Hidden below sm. Adding the Menü button left the header with a mark, a
        wordmark and two buttons on a 390px screen, and "MEVCUT DIGITAL" wrapped to
        two lines inside a 65px bar, so the first thing a phone visitor saw was a
        broken lockup. The mark alone carries the brand at that width, and the
        anchor's aria-label already names the site for anyone not looking at it.
      */}
      <span class="hidden font-display text-base font-bold tracking-tight whitespace-nowrap sm:inline md:text-lg">
        MEVCUT <span class="text-charcoal">DIGITAL</span>
      </span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Ana menü">
      {
        menu.map((m) => (
          <a
            href={m.yol}
            class="baglanti-alti py-1 text-sm font-semibold text-charcoal transition-colors duration-200 hover:text-navy"
          >
            {m.ad}
          </a>
        ))
      }
    </nav>

    <a
      href={whatsapp()}
      target="_blank"
      rel="noopener"
      class="inline-flex min-h-11 items-center gap-2 rounded-full bg-navy px-5 py-2.5 text-sm font-semibold text-stone transition-transform duration-200 hover:bg-navy-deep active:scale-[0.97]"
    >
      <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill="currentColor" aria-hidden="true">
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 0 1 6.988 2.896 9.82 9.82 0 0 1 2.892 6.994c-.003 5.45-4.437 9.884-9.884 9.884m8.413-18.297A11.82 11.82 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.88 11.88 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 0 0-3.48-8.413Z"
        ></path>
      </svg>
      <span class="hidden sm:inline">WhatsApp</span>
      <span class="sm:hidden">Yazın</span>
    </a>

      {/*
        Below md there was no navigation at all: the <nav> above is `hidden md:flex`
        with nothing behind it, so a phone visitor could only scroll. A <details>
        disclosure fixes that without shipping a menu framework. It is keyboard
        operable, announces its own expanded state, and works with scripting off,
        which the rest of this site's chrome also does.

        Labelled "Menü", not a bare icon: an unlabelled hamburger is exactly the
        thing a first-time visitor on a shop owner's phone hesitates over.
      */}
      <details class="menu-ac relative md:hidden">
        <summary
          class="inline-flex min-h-11 min-w-11 cursor-pointer list-none items-center gap-2 rounded-full border border-navy/40 px-4 py-2.5 font-display text-sm font-semibold text-navy"
        >
          <svg viewBox="0 0 20 20" class="h-4 w-4 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path class="menu-cizgi-1" d="M3 6h14" />
            <path class="menu-cizgi-2" d="M3 13h14" />
          </svg>
          Menü
        </summary>

        <nav
          class="absolute right-0 z-50 mt-3 w-56 rounded-2xl border border-charcoal/15 bg-stone-light p-2 shadow-[0_18px_44px_-22px_rgb(46_59_105_/_0.5)]"
          aria-label="Ana menü"
        >
          {
            menu.map((m) => (
              <a
                href={m.yol}
                class="flex min-h-11 items-center rounded-xl px-4 font-display text-base font-semibold text-navy hover:bg-navy/5"
              >
                {m.ad}
              </a>
            ))
          }
        </nav>
      </details>
  </div>
</header>

<script>
  /*
   * Close the disclosure when a link inside it is taken. Without this the panel
   * stays open over the section it just jumped to, because <details> has no reason
   * to close on its own. Progressive enhancement only: with scripting off the menu
   * still opens, still navigates, and merely stays open.
   */
  for (const ac of document.querySelectorAll<HTMLDetailsElement>('details.menu-ac')) {
    ac.addEventListener('click', (olay) => {
      if ((olay.target as HTMLElement).closest('a')) ac.open = false;
    });
  }
</script>
