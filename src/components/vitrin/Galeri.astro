---
/**
 * Photo grid.
 *
 * Width and height are declared on every image so the browser reserves the box
 * before the file lands. Without it, four photos loading over a weak mobile
 * connection shove the hours and address down the page repeatedly while someone
 * is trying to read them, which is most of a bad CLS score and all of a bad
 * first impression.
 *
 * Nothing here is eager: the gallery always sits below the fold, so every image
 * is lazy and async-decoded. The hero photo is the only eager image on a Vitrin
 * page and it lives in the template, not here.
 */
import type { VitrinGorsel } from '../../data/vitrin';
import { gorselNitelikleri } from '../../lib/gorsel';

interface Props {
  gorseller: VitrinGorsel[];
  baslik: string;
  eyebrow: string;
  /** Yemek photos look better square; a dükkân interior wants landscape. */
  oran?: 'kare' | 'yatay';
}

const { gorseller, baslik, eyebrow, oran = 'kare' } = Astro.props;
---

{
  gorseller.length > 0 && (
    <section id="galeri" class="v-section">
      <div class="v-shell">
        <div class="v-reveal max-w-2xl">
          <p class="v-eyebrow">{eyebrow}</p>
          <h2 class="mt-3 text-3xl md:text-4xl">{baslik}</h2>
        </div>

        <ul class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
          {gorseller.map((gorsel) => (
            <li class="v-reveal overflow-hidden rounded" style="background:var(--v-sunken)">
              <img
                {...gorselNitelikleri(gorsel.src)}
                alt={gorsel.alt}
                width={oran === 'kare' ? 800 : 900}
                height={oran === 'kare' ? 800 : 600}
                loading="lazy"
                decoding="async"
                class="v-galeri-gorsel"
                style={`aspect-ratio:${oran === 'kare' ? '1 / 1' : '3 / 2'}`}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .v-galeri-gorsel {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-out-soft);
  }

  /*
   * Hover only. There is no tap equivalent and there should not be: on a phone
   * this would fire on scroll and make the grid twitch.
   */
  @media (hover: hover) {
    .v-galeri-gorsel:hover {
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .v-galeri-gorsel {
      transition: none;
    }

    .v-galeri-gorsel:hover {
      transform: none;
    }
  }
</style>
