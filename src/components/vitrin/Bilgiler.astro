---
/**
 * Hours and address. The two things people actually came for.
 *
 * Two details here are not decoration:
 *
 *  - `kapaliGunler` is rendered on its own line rather than as another table
 *    row. Salon İmaj writes "* Çarşamba ve Pazar günleri kapalıyız" with an
 *    asterisk for a reason. Someone who skims a table sees "09:00 - 20:00" and
 *    drives over on a Sunday.
 *
 *  - `tarif` is the landmark directions. "PTT'nin yanındaki pasajın girişi" is
 *    how people in İstanbul actually navigate, and no template builder has a
 *    field for it. A map link is offered underneath, never an embedded iframe,
 *    which would ship Google's cookies onto a shop's site for no benefit.
 */
import type { Vitrin } from '../../data/vitrin';
import Durum from './Durum.astro';

interface Props {
  vitrin: Vitrin;
}

const { vitrin } = Astro.props;
const { adres, saatler, kapaliGunler } = vitrin;

const haritaAramasi =
  adres.haritaUrl ??
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
    `${vitrin.isletme} ${adres.satirlar.join(' ')} ${adres.ilce} ${adres.sehir}`,
  )}`;
---

<section id="bilgiler" class="v-section">
  <div class="v-shell grid gap-10 md:grid-cols-2 md:gap-14">
    <div class="v-reveal">
      <p class="v-eyebrow">Çalışma Saatleri</p>
      <h2 class="mt-3 text-3xl md:text-4xl">Ne zaman açığız</h2>

      <Durum saatler={saatler} class="mt-5" />

      <dl class="mt-6 divide-y" style="border-color:var(--v-line)">
        {
          saatler.map((s) => (
            <div class="flex items-baseline justify-between gap-6 py-3">
              <dt class="font-semibold">{s.gunler}</dt>
              <dd class="tabular-nums" style="color:var(--v-muted)">
                {s.acilis} - {s.kapanis}
              </dd>
            </div>
          ))
        }
      </dl>

      {
        kapaliGunler && (
          <p
            class="mt-4 rounded px-4 py-3 text-sm font-semibold"
            style="background:var(--v-sunken);color:var(--v-ink)"
          >
            {kapaliGunler}
          </p>
        )
      }
    </div>

    <div class="v-reveal">
      <p class="v-eyebrow">Adres</p>
      <h2 class="mt-3 text-3xl md:text-4xl">Nerede bulabilirsiniz</h2>

      <address class="mt-6 not-italic">
        {adres.satirlar.map((satir) => <p class="text-lg">{satir}</p>)}
        <p class="text-lg">{adres.ilce} / {adres.sehir}</p>
      </address>

      {
        adres.tarif && (
          <p class="mt-4 leading-relaxed" style="color:var(--v-muted)">
            {adres.tarif}
          </p>
        )
      }

      <a
        href={haritaAramasi}
        target="_blank"
        rel="noopener"
        class="v-btn v-btn-ghost mt-6"
      >
        Yol tarifi al
      </a>
    </div>
  </div>
</section>
