---
import Layout from '../../layouts/Layout.astro';
import IsKarti from '../../components/IsKarti.astro';
import KonseptNotu from '../../components/KonseptNotu.astro';
import { projeler } from '../../data/projeler';
import { whatsapp } from '../../data/site';
import { gorselNitelikleri } from '../../lib/gorsel';

export function getStaticPaths() {
  return projeler.map((proje) => ({
    params: { slug: proje.slug },
    props: { proje },
  }));
}

const { proje } = Astro.props;

/*
 * The next two in the list, wrapping around, rather than the first two overall.
 * `filter(...).slice(0, 2)` recommended Bereket and Çınaraltı from every page
 * except those two, so six of the eight case studies pointed at the same pair and
 * the section may as well have been static.
 */
const buradan = projeler.findIndex((p) => p.slug === proje.slug);
const digerleri = [1, 2].map((adim) => projeler[(buradan + adim) % projeler.length]);
const ctaMesaji = `Merhaba, sitenizdeki ${proje.isletme} çalışmasını gördüm. Benim işletmem için de benzer bir site yaptırmak istiyorum.`;

// Social previews need a 1200x630 raster; the card image is 1200x750 WebP.
const ogGorsel = `/isler/${proje.slug}-og.jpg`;

// Marked up as CreativeWork rather than a testimonial or Review, because nobody
// hired us for these. Claiming otherwise in structured data would be a lie Google reads.
const isSema = {
  '@type': 'CreativeWork',
  name: `${proje.isletme} konsept web sitesi`,
  headline: proje.baslik,
  abstract: proje.ozet,
  inLanguage: 'tr',
  creator: { '@id': 'https://mevcut.digital/#kurulus' },
  image: `https://mevcut.digital${proje.gorsel}`,
  url: `https://mevcut.digital/isler/${proje.slug}/`,
  genre: `${proje.sektor} web sitesi`,
  creditText: proje.kurgu
    ? 'Konsept çalışma. İşletme kurgusaldır; gerçek bir dükkân değildir.'
    : 'Konsept çalışma. İşletmenin resmi web sitesi değildir.',
};
---

<Layout
  baslik={proje.seoBaslik}
  aciklama={proje.seoAciklama}
  gorsel={ogGorsel}
  gorselAlt={proje.gorselAlt}
  kirintiYolu={[{ ad: proje.seoBaslik, yol: `/isler/${proje.slug}/` }]}
  semaEkleri={[isSema]}
>
  <article>
    {/* ---------- BAŞLIK ---------- */}
    <header class="border-b border-charcoal/10">
      <div class="container-page py-14 md:py-20">
        <nav aria-label="Sayfa yolu" class="mb-8">
          <a
            href="/#isler"
            class="inline-flex min-h-11 items-center gap-2 font-display text-sm font-semibold text-charcoal/80 transition-colors duration-200 hover:text-navy"
          >
            <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M16 10H5M9 5.5 4.5 10 9 14.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Tüm işler
          </a>
        </nav>

        <div class="max-w-4xl">
          <div class="flex flex-wrap items-center gap-3">
            <span class="rounded-full bg-navy/8 px-3 py-1 font-display text-[0.68rem] font-semibold tracking-widest text-navy uppercase">
              Konsept çalışma
            </span>
            <span class="font-display text-xs font-semibold tracking-widest text-charcoal/80 uppercase">
              {proje.sektor} · {proje.sehir}
            </span>
          </div>

          <h1 class="mt-6 text-[clamp(2rem,5vw,3.5rem)] font-bold">{proje.baslik}</h1>
          <p class="mt-4 font-display text-lg font-semibold text-charcoal/80">{proje.isletme}</p>
          <p class="mt-6 max-w-2xl text-lg text-charcoal/80 md:text-xl">{proje.ozet}</p>

          <div class="mt-9 flex flex-wrap gap-4">
            <a
              href={proje.demoUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-13 items-center gap-2.5 rounded-full bg-navy px-7 py-3.5 font-display text-base font-semibold text-stone transition-all duration-200 hover:bg-navy-deep active:scale-[0.98]"
            >
              Siteyi canlı aç
              <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M7 4.5h8.5V13M15.5 4.5 4.5 15.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <a
              href={whatsapp(ctaMesaji)}
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-13 items-center rounded-full border border-navy/25 px-7 py-3.5 font-display text-base font-semibold text-navy transition-colors duration-200 hover:border-navy/60 hover:bg-navy/5"
            >
              Benzerini istiyorum
            </a>
          </div>
        </div>
      </div>
    </header>

    {/* ---------- GÖRSEL ---------- */}
    <div class="container-page py-12 md:py-16">
      {/*
        The figcaption used to sit outside the figure as its sibling, which is
        invalid: a figcaption is only a caption when it is a child of the figure,
        and as a sibling it was just a stray paragraph with no association to the
        image for assistive tech.
      */}
      <figure class="reveal">
        <div class="overflow-hidden rounded-2xl border border-charcoal/10 bg-stone-dark">
          <img
            {...gorselNitelikleri(proje.gorsel, '(min-width: 1216px) 1136px, calc(100vw - 3rem)')}
            alt={proje.gorselAlt}
            width="1200"
            height="750"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full object-cover object-top"
          />
        </div>
        <figcaption class="mt-4 text-sm text-charcoal/80">
          {
            proje.kurgu
              ? `${proje.isletme} kurgusal bir örnek işletmedir; gerçek bir dükkân değildir. Sayfadaki fiyatlar ve yorumlar, tasarımı göstermek için yazılmış örnek içeriktir.`
              : `${proje.isletme} için hazırlanan konsept çalışma. İşletmenin resmi web sitesi değildir.`
          }
        </figcaption>
      </figure>
    </div>

    {/* ---------- HİKÂYE + ÖZELLİKLER ---------- */}
    <div class="border-y border-charcoal/10 bg-stone-light/60">
      <div class="container-page grid gap-14 py-20 md:py-24 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20">
        <div>
          {/*
            Was a "YAKLAŞIM" kicker. A real heading replaces it: the aside opposite
            already carries an h2, so a bare label on this side left the column
            without a peer in the outline as well as failing contrast.
          */}
          <h2 class="reveal font-display text-lg font-semibold">Neden böyle kurduk</h2>
          <div class="reveal reveal-delay-1 mt-6 space-y-5 text-lg text-charcoal/80">
            {proje.hikaye.map((paragraf) => <p>{paragraf}</p>)}
          </div>
        </div>

        <aside class="reveal reveal-delay-2">
          <h2 class="font-display text-lg font-semibold">Sayfada neler var</h2>
          <ul class="mt-5 space-y-3.5" role="list">
            {
              proje.ozellikler.map((ozellik) => (
                <li class="flex gap-3">
                  <svg
                    viewBox="0 0 20 20"
                    class="mt-1 h-4 w-4 shrink-0 text-navy"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.25"
                    aria-hidden="true"
                  >
                    <path d="m4.5 10.5 3.5 3.5 7.5-8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span class="text-charcoal/80">{ozellik}</span>
                </li>
              ))
            }
          </ul>

          <div class="mt-9 rounded-xl border border-charcoal/12 bg-stone p-6">
            <h3 class="font-display text-xs font-semibold tracking-widest text-charcoal/80 uppercase">
              Teknik not
            </h3>
            <p class="mt-3 text-sm text-charcoal/80">{proje.teknik}</p>
            <p class="mt-4 font-display text-sm font-semibold text-navy">
              Paket: {proje.paket}
            </p>
          </div>
        </aside>
      </div>
    </div>

    {/* ---------- DİĞER İŞLER ---------- */}
    <div class="container-page py-20 md:py-24">
      <h2 class="reveal font-display text-2xl font-bold">Diğer çalışmalar</h2>
      {/*
        These two cards used to be hand-rolled markup rather than <IsKarti />, and
        they dropped the "Kurgu konsept" badge along the way. The result was that
        every case-study page showed two businesses with a sector, a real İstanbul
        neighbourhood and a confident headline, and nothing anywhere on the page
        said that two of them are invented and none of them hired us. The whole
        reason IsKarti and KonseptNotu are components is to make that impossible,
        and this page was routing around both.

        Use the components. Do not re-inline these cards.
      */}
      <ul class="reveal mt-9 grid gap-7 sm:grid-cols-2" role="list">
        {digerleri.map((diger) => <IsKarti proje={diger} />)}
      </ul>
      <KonseptNotu projeler={digerleri} class="reveal mt-8" />
    </div>

    {/* ---------- CTA ---------- */}
    <section class="bg-navy text-stone">
      <div class="container-page py-16 text-center md:py-20">
        <h2 class="reveal mx-auto max-w-2xl text-[clamp(1.6rem,3.5vw,2.5rem)] font-bold !text-stone">
          İşletmeniz için de böyle bir sayfa yapalım.
        </h2>
        <p class="reveal reveal-delay-1 mx-auto mt-5 max-w-xl text-lg text-stone/80">
          Örnek tasarım ücretsiz. Beğenirseniz konuşuruz, beğenmezseniz yükümlülüğünüz yok.
        </p>
        <a
          href={whatsapp(ctaMesaji)}
          target="_blank"
          rel="noopener"
          class="reveal reveal-delay-2 mt-9 inline-flex min-h-13 items-center gap-2.5 rounded-full bg-stone px-8 py-3.5 font-display text-base font-semibold text-navy transition-all duration-200 hover:bg-white active:scale-[0.98]"
        >
          WhatsApp’tan yazın
        </a>
      </div>
    </section>
  </article>
</Layout>
